---
// Inline Lucide icon (ISC license, https://lucide.dev). Rendered at build time; no client JS.
import * as icons from 'lucide-static';

interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className = '', strokeWidth = 1.75 } = Astro.props;
const raw = (icons as unknown as Record<string, string>)[name];
if (!raw) throw new Error(`Unknown icon: ${name}`);

const svg = raw
  .replace(/\s+class="[^"]*"/, '')
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, `stroke-width="${strokeWidth}"`)
  .replace('<svg', `<svg aria-hidden="true" focusable="false" class="icon ${className}"`);
---

<Fragment set:html={svg} />
