---
import type { Crumb } from '../layouts/Base.astro';
import Monogram from './Monogram.astro';

interface Props {
  title: string;
  eyebrow?: string;
  /** Ancestors between Home and this page. */
  crumbs?: Crumb[];
  /** Short label for this page in the breadcrumb (defaults to the title). */
  current?: string;
  variant?: 'default' | 'sports';
}

const { title, eyebrow, crumbs, current, variant = 'default' } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['page-header', `page-header--${variant}`, { 'has-aside': hasAside }]}>
  <Monogram class="ph-mark" />
  <div class="container ph-grid">
  <div class="ph-inner">
    {
      crumbs && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol role="list">
            <li>
              <a href="/">Home</a>
            </li>
            {crumbs.map((c) => (
              <li>
                <a href={c.href}>{c.label}</a>
              </li>
            ))}
            <li aria-current="page">{current ?? title}</li>
          </ol>
        </nav>
      )
    }
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {
      Astro.slots.has('lead') && (
        <div class="lead ph-lead">
          <slot name="lead" />
        </div>
      )
    }
    {
      Astro.slots.has('actions') && (
        <div class="btn-row ph-actions">
          <slot name="actions" />
        </div>
      )
    }
    <slot />
  </div>
  {hasAside && <div class="ph-aside"><slot name="aside" /></div>}
  </div>
</section>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2.5rem, 6vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .page-header :global(.ph-mark) {
    position: absolute;
    top: -12%;
    right: max(-4rem, -6vw);
    height: 135%;
    width: auto;
    color: var(--plum-700);
    opacity: 0.06;
    pointer-events: none;
  }

  .page-header--sports :global(.ph-mark) {
    color: var(--gold-400);
    opacity: 0.22;
  }

  .ph-grid {
    position: relative;
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .ph-inner {
    position: relative;
    min-width: 0;
  }

  @media (min-width: 64em) {
    .has-aside .ph-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }

  .ph-inner > :global(*) {
    max-width: 50rem;
  }

  h1 {
    margin-bottom: 0.4em;
  }

  .page-header--sports h1 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 5vw, 5.5rem);
    font-weight: 700;
    letter-spacing: 0.005em;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--plum-700);
  }

  .ph-lead :global(p:last-child) {
    margin-bottom: 0;
  }

  .ph-actions {
    margin-top: 1.75rem;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: #a59fab;
  }

  .crumbs a {
    color: var(--muted);
  }

  .crumbs a:hover {
    color: var(--plum-700);
  }
</style>
