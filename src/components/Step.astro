---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<li class="step">
  <h3>{title}</h3>
  <div class="step-body"><slot /></div>
</li>

<style>
  .step {
    position: relative;
    padding: 1.5rem 1.5rem 1.5rem 4.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    counter-increment: step;
  }

  .step::before {
    content: counter(step);
    position: absolute;
    left: 1.25rem;
    top: 1.35rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--plum-700);
    color: var(--white);
    font-weight: 800;
    font-size: 1.125rem;
  }

  h3 {
    margin-bottom: 0.35rem;
    font-size: var(--step-1);
  }

  .step-body {
    color: var(--muted);
  }

  .step-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
