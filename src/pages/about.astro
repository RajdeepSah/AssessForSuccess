---
import Base from '../layouts/Base.astro';
import Confirm from '../components/Confirm.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Monogram from '../components/Monogram.astro';
import PageHeader from '../components/PageHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import WholePerson from '../components/WholePerson.astro';
---

<Base
  title="About Assess for Success"
  description="Assess for Success provides behavioral health care for adults and youth, and A4S Sports for young people, in Topeka, Kansas."
  breadcrumbs={[{ label: 'About', href: '/about/' }]}
>
  <PageHeader title="About Assess for Success" crumbs={[]} current="About">
    <p slot="lead">
      Assess for Success provides behavioral health care for adults and youth, and runs A4S Sports for young people, in Topeka,
      Kansas.
    </p>
  </PageHeader>

  <section class="section" aria-labelledby="who-title">
    <div class="container who">
      <div class="portrait" aria-hidden="true">
        <Monogram class="portrait-mark" />
        <span class="portrait-note">Photo coming soon</span>
      </div>
      <div class="prose">
        <h2 id="who-title">Who we are</h2>
        <p><Confirm note="Counselor/owner name, role, and a photo" /></p>
        <p><Confirm note="Credentials and licensure (licensing body and license number)" /></p>
        <p><Confirm note="Short bio: background and experience serving Topeka" /></p>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="approach-title">
    <div class="container approach">
      <WholePerson variant="compact" />
      <div class="prose">
        <h2 id="approach-title">Our approach</h2>
        <p class="lead">In counseling, we consider your physical, mental, social, and spiritual well-being.</p>
        <a class="link-arrow" href="/behavioral-health/treatment/#whole-person">How we approach treatment <Icon name="ArrowRight" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="programs-title">
    <div class="container">
      <div class="section-head">
        <h2 id="programs-title">One organization, two programs</h2>
      </div>
      <div class="grid grid--2">
        <ServiceCard title="Behavioral Health Care" href="/behavioral-health/" icon="HeartHandshake" cta="Explore Behavioral Health Care">
          <p>For adults and youth: assessments, treatment for substance use disorders, and alcohol, drug, and anger education.</p>
        </ServiceCard>
        <ServiceCard title="A4S Sports" href="/sports/" icon="Trophy" cta="Explore A4S Sports">
          <p>For youth: teams, one-on-one skills training, and mentoring.</p>
        </ServiceCard>
      </div>
    </div>
  </section>

  <section class="section section--tight section--white" aria-labelledby="licensing-title">
    <div class="container prose">
      <h2 id="licensing-title">Licensing</h2>
      <p>
        <Confirm
          note="Agency licensing details. The old site listed licensure for early intervention/interim services, outpatient, intensive outpatient, counseling treatment, and alcohol and drug assessment and referral"
        />
      </p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .who {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 56em) {
    .who {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 4rem;
    }
  }

  .portrait {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    max-width: 26rem;
    border-radius: var(--radius);
    background: linear-gradient(160deg, var(--plum-50), var(--plum-100));
    overflow: hidden;
  }

  :global(.portrait-mark) {
    height: 62%;
    width: auto;
    color: var(--plum-700);
    opacity: 0.18;
  }

  .portrait-note {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--white);
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 650;
  }

  .approach {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 48em) {
    .approach {
      grid-template-columns: auto 1fr;
      gap: clamp(2rem, 6vw, 5rem);
    }
  }
</style>
