---
import '@fontsource-variable/figtree';
import '@fontsource/barlow-condensed/700.css';
import '../styles/global.css';
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

export interface Crumb {
  label: string;
  href: string;
}

interface Props {
  /** Page title; " | Assess for Success" is appended unless fullTitle is set. */
  title: string;
  description: string;
  fullTitle?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Breadcrumb trail after Home (used for BreadcrumbList structured data). */
  breadcrumbs?: Crumb[];
  theme?: 'default' | 'sports';
}

const {
  title,
  description,
  fullTitle = false,
  ogImage = '/og/default.png',
  ogImageAlt = 'Assess for Success: assessments, treatment, and education for adults and youth in Topeka, Kansas',
  noindex = false,
  jsonLd = [],
  breadcrumbs = [],
  theme = 'default',
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogUrl = new URL(ogImage, site.url).href;

const ld = [...jsonLd];
if (breadcrumbs.length) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ label: 'Home', href: '/' }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: new URL(c.href, site.url).href,
    })),
  });
}
const json = (o: unknown) => JSON.stringify(o).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FBF9F6" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {ld.map((obj) => <script is:inline type="application/ld+json" set:html={json(obj)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
